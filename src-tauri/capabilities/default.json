{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for SSH GUI",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:app:default",
    "core:tray:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open"
  ]
}
